<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 EXPLORAÇÃO LIVRE"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/txtStatusExploracao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aponte o celular ao seu redor..."
        android:textColor="#00FF00"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="64dp" />

    <!-- Botão Sair centralizado e acessível -->
    <Button
        android:id="@+id/btnSairExploracao"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cornerRadius="24dp"
        android:backgroundTint="#F44336"
        android:text="SAIR"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:hapticFeedbackEnabled="true"
        android:contentDescription="Botão Sair. Toque para encerrar o modo de exploração livre e voltar ao menu principal." />

</LinearLayout>
