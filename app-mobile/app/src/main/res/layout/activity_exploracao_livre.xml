<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#000000">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔍 RADAR DE AMBIENTE"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtStatusVarredura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscando locais próximos..."
        android:textSize="18sp"
        android:textColor="#00FF00"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <!-- CARTÃO GIGANTE: MOSTRA O QUE ESTÁ PERTO -->
    <LinearLayout
        android:id="@+id/cardMaisProximo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFD600"
        android:padding="32dp"
        android:visibility="gone"
        android:gravity="center"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 VOCÊ ESTÁ PERTO DE:"
            android:textColor="#424242"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/txtNomeMaisProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Local"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/txtDistanciaMaisProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sinal: -50 dBm | ~2.5m"
            android:textColor="#212121"
            android:textSize="20sp"/>
    </LinearLayout>

    <!-- Espaçador para empurrar o botão Sair lá para o fundo -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- ÚNICO BOTÃO DA TELA -->
    <Button
        android:id="@+id/btnSairExploracao"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:cornerRadius="20dp"
        android:backgroundTint="#F44336"
        android:text="SAIR"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:hapticFeedbackEnabled="true"
        android:contentDescription="Encerrar exploração livre" />

</LinearLayout>