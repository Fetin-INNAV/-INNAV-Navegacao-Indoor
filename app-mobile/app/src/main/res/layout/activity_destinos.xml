<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SELECIONE O DESTINO"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:contentDescription="Tela de seleção de destino. Opções abaixo." />

    <Button
        android:id="@+id/btnDestinoLab"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:cornerRadius="24dp"
        android:backgroundTint="#FFEB3B"
        android:text="LABORATÓRIO DE\nHARDWARE"
        android:textColor="#000000"
        android:textSize="36sp"
        android:textStyle="bold"
        android:hapticFeedbackEnabled="true"
        android:contentDescription="Laboratório de Hardware. Toque duas vezes para iniciar a rota." />

</LinearLayout>