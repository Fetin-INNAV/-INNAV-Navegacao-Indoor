<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 INDO PARA:"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LABORATÓRIO DE HARDWARE"
        android:textColor="#FFEB3B"
        android:textSize="32sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp" />

    <TextView
        android:id="@+id/txtSinalAoVivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buscando sinal do ESP32..."
        android:textColor="#00FF00"
        android:textSize="28sp"
        android:gravity="center"
        android:layout_marginBottom="64dp" />

    <Button
        android:id="@+id/btnAjuda"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:cornerRadius="24dp"
        android:backgroundTint="#F44336"
        android:text="AJUDA / CANCELAR"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:hapticFeedbackEnabled="true"
        android:contentDescription="Botão de ajuda. Toque duas vezes para cancelar a rota e voltar para a escolha de destinos." />

</LinearLayout>