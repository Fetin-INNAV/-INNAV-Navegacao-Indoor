<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:weightSum="2">

    <Button
        android:id="@+id/btnEscolherDestino"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:backgroundTint="#FFEB3B"
        android:text="ESCOLHER DESTINO"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        android:contentDescription="Botão Escolher Destino. Toque duas vezes para falar o nome do local para onde deseja ir." />

    <Button
        android:id="@+id/btnExploracaoLivre"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:backgroundTint="#FFEB3B"
        android:text="EXPLORAÇÃO LIVRE"
        android:textColor="#000000"
        android:textSize="32sp"
        android:textStyle="bold"
        android:contentDescription="Botão de modo Radar. Toque duas vezes para iniciar a exploração livre e ouvir os pontos de interesse enquanto caminha." />

</LinearLayout>